{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx --yes --package npm@12.2.2 -- npm run build",
  "outputDirectory": "dist",
  "installCommand": "npx --yes --package npm@12.2.2 -- npm ci --include=dev --no-audit --no-fund",
  "rewrites": [
    {
      "source": "/team",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    }
  ]
}
